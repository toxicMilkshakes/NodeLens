<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Surface" CornerRadius="20" BorderBrush="#34464B" BorderThickness="1" Padding="21,17,21,16" TextElement.Foreground="#E9F2F0" TextElement.FontFamily="Microsoft YaHei UI" SnapsToDevicePixels="True">
 <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#182227"/><GradientStop Color="#0D1519" Offset="1"/></LinearGradientBrush></Border.Background>
 <Border.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#9EAEB2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bg" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#29383D"/><Setter Property="Foreground" Value="#E9F2F0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Border.Resources>
 <StackPanel>
  <Grid x:Name="DragBar" Background="Transparent" Margin="0,0,0,17">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Background="#263E3C" Width="25" Height="25" CornerRadius="8" Margin="0,0,9,0"><Path Stroke="#80EBC3" StrokeThickness="1.6" Data="M 5,13 L 9,13 L 12,6 L 15,18 L 18,11 L 21,11"/></Border>
    <TextBlock Text="N O D E L E N S" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#CCDAD8"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="PinButton" Content="置顶" ToolTip="切换窗口置顶"/>
    <Button x:Name="CompactButton" Content="收起" ToolTip="切换精简小窗"/>
    <Button x:Name="HideButton" Content="—" ToolTip="隐藏到系统托盘；双击托盘图标恢复"/>
   </StackPanel>
  </Grid>
  <StackPanel x:Name="FullPanel">
   <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="ClientButton" HorizontalAlignment="Left" Padding="0,3,5,3" ToolTip="选择数据来源"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ClientName" Text="自动识别" FontSize="11"/><TextBlock Text="  ⌄"/></StackPanel></Button>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#D6B681" Margin="0,0,6,0"/><TextBlock x:Name="StateText" Text="正在查找" FontSize="10" Foreground="#ACBBB9"/></StackPanel>
   </Grid>
   <TextBlock x:Name="NodeText" Text="等待连接" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
   <TextBlock x:Name="DetailText" Text="启动 VPN 客户端后自动读取" Foreground="#8EA2A7" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,0,18"/>
   <Border Background="#17252A" CornerRadius="12" Padding="15,12,15,13" BorderBrush="#26383E" BorderThickness="1">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="↓  下载" FontSize="10" Foreground="#85E5C2" Margin="0,0,0,5"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="DownValue" Text="—" FontSize="29" FontFamily="Segoe UI" FontWeight="SemiBold"/><TextBlock x:Name="DownUnit" Text="B/s" FontSize="10" Foreground="#A6B8BA" VerticalAlignment="Bottom" Margin="5,0,0,6"/></StackPanel></StackPanel>
     <Border Grid.Column="1" Background="#2C3E43" Margin="0,4"/>
     <StackPanel Grid.Column="2" Margin="17,0,0,0"><TextBlock Text="↑  上传" FontSize="10" Foreground="#E7C394" Margin="0,0,0,5"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="UpValue" Text="—" FontSize="29" FontFamily="Segoe UI" FontWeight="SemiBold"/><TextBlock x:Name="UpUnit" Text="B/s" FontSize="10" Foreground="#A6B8BA" VerticalAlignment="Bottom" Margin="5,0,0,6"/></StackPanel></StackPanel>
    </Grid>
   </Border>
   <Grid Margin="0,15,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="速率趋势 · 最近 60 秒" Foreground="#7F989F" FontSize="9" VerticalAlignment="Center"/>
    <Button x:Name="ProbeButton" Grid.Column="1" Padding="8,3" Background="#223332" ToolTip="立即测量到 gstatic 的 HTTP 延时；不是带宽测速"><StackPanel Orientation="Horizontal"><TextBlock Text="延时  " Foreground="#8EB3A7" FontSize="10"/><TextBlock x:Name="DelayText" Text="—" Foreground="#98E3C7" FontSize="11" FontWeight="SemiBold"/></StackPanel></Button>
   </Grid>
   <Border x:Name="GraphHost" Height="52"/>
   <TextBlock x:Name="LatencyNote" Text="等待测量" Foreground="#81999F" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
   <Border Height="1" Background="#26383D" Margin="0,13,0,10"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="DataNote" Text="尚无实时数据" Foreground="#7F989F" FontSize="9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="OpenClientButton" Content="显示客户端" Padding="5,4"/><Button x:Name="SettingsButton" Content="设置" Padding="7,4,0,4"/></StackPanel>
   </Grid>
  </StackPanel>
  <StackPanel x:Name="MiniPanel" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
   <TextBlock x:Name="MiniNode" Text="等待连接" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
   <TextBlock x:Name="MiniDelay" Foreground="#B8CDCE" FontSize="11" Text="— ms" VerticalAlignment="Center" Margin="0,0,14,0"/>
   <TextBlock x:Name="MiniDown" Foreground="#85E5C2" FontFamily="Segoe UI" FontSize="12" Text="↓ —" MinWidth="86" VerticalAlignment="Center"/>
   <TextBlock x:Name="MiniUp" Foreground="#E7C394" FontFamily="Segoe UI" FontSize="12" Text="↑ —" MinWidth="86" VerticalAlignment="Center"/>
   <TextBlock x:Name="MiniNote" Visibility="Collapsed"/>
  </StackPanel>
 </StackPanel>
</Border>
